def cmd_peek(args, tr):
    n = int(args.n, 0) if isinstance(args.n, str) else args.n
    data = tr.peek(int(args.addr, 0), n)
    for off in range(0, len(data), 16):
        row = data[off:off + 16]
        hexs = " ".join(f"{b:02x}" for b in row)
        asci = "".join(chr(b) if 32 <= b < 127 else "." for b in row)
        print(f"{int(args.addr,0)+off:08x}  {hexs:<48}  {asci}")


def cmd_trace(args, tr):
    report = tr.peek(0x086c9b84, 512)
    if struct.unpack_from("<I", report, 0x2c)[0] != 0x32505452:
        raise SystemExit("The current heap resident has not published a boot report")
    address = struct.unpack_from("<I", report, 0x150)[0]
    if not 0x08d00000 <= address < 0x0a000000 - 4112:
        raise SystemExit("The current resident has not published a trace ring")
    data = tr.peek(address, 4112)
    if len(data) < 16:
        sys.exit(f"peek returned no data — check the iPod is attached ({tr.desc})")
    magic, idx, count, _ = struct.unpack_from("<IIII", data, 0)
    if magic != TRACE_MAGIC:
        sys.exit("trace ring magic is %08x, not 'RTBH' — the resident hasn't logged yet "
                 "(or DRAM was cleared by a cold boot)" % magic)
    cap = (len(data) - 16) // 16          # ring slot count
    n = min(count, cap)
    tail = min(args.n, n)
    print(f"HBTR idx={idx} count={count}  (last {tail} of {n}, oldest first)")
    # circular ring: the newest entry is slot (idx-1); walk back `tail` then print
    # oldest-first so the LAST printed line is the most recent.
    slots = [(idx - 1 - k) % cap for k in range(tail)][::-1]
    for s in slots:
        o = 16 + s * 16
        tag = data[o:o + 8].rstrip(b" \x00").decode("ascii", "replace")
        v1, v2 = struct.unpack_from("<II", data, o + 8)
        print(f"{tag:<8} 0x{v1:08x} 0x{v2:08x}")


def cmd_pull(args, tr):
    """Pull files off the iPod's FAT disk (over whichever transport). `media` grabs
    screenshots + recordings, converts them, and clears them from the device;
    `bench` grabs the benchmark CSVs into bench_results/. Conversion is done here
    with Pillow + recsplit.py so it works on Linux and macOS alike."""
    what = getattr(args, "what", "media") or "media"

    if what == "bench":
        out = ROOT / "bench_results"; out.mkdir(exist_ok=True)
        n = tr._mount_pull(["Data/Bench/bench_*.csv"])
        if n < 0:
            sys.exit("could not mount the iPod (disk mode?) — try replugging")
        if n == 0:
            print("no benchmark CSVs on the device"); return
        tr._fetch(str(out))
        csvs = sorted(out.glob("bench_*.csv"))
        print(f"==> pulled {len(csvs)} CSV(s) -> {out}")
        if csvs:
            latest = max(csvs, key=lambda p: p.stat().st_mtime)
            print(f"\n=== {latest.name} ===\n{latest.read_text()}")
        return

    # media
    import datetime
    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    out = Path(args.out).expanduser() if getattr(args, "out", None) \
        else Path.home() / f"Desktop/ipod_media_{stamp}"
    orig = out / "originals"; orig.mkdir(parents=True, exist_ok=True)

    globs = ["screenshot[0-9]*.bmp", "rec[0-9]*.rec"]
    n = tr._mount_pull(globs)
    if n < 0:
        sys.exit("could not mount the iPod (disk mode?) — try replugging")
    if n == 0:
        print("nothing to pull (no screenshots/recordings on the iPod)")
        for p in (orig, out):
            try: p.rmdir()
            except OSError: pass
        return
    tr._fetch(str(orig))

    try:
        from PIL import Image
    except ImportError:
        sys.exit("Pillow is required to convert media — run `start deps`")
    nshot = nrec = 0
    for b in sorted(orig.glob("*.bmp")):
        (out / "screenshots").mkdir(exist_ok=True)
        try:
            Image.open(b).save(out / "screenshots" / (b.stem + ".png")); nshot += 1
        except Exception:
            pass
    for r in sorted(orig.glob("*.rec")):
        (out / "recordings").mkdir(exist_ok=True)
        d = out / "recordings" / r.stem
        if subprocess.run([sys.executable, str(ROOT / "tools" / "recsplit.py"), str(r), str(d)],
                          capture_output=True).returncode == 0:
            frames = len(list(d.glob("*.png")))
            print(f"   {r.stem} -> {frames} frame(s)"); nrec += 1

    # only wipe the device once the originals are safely on this machine
    tr._clear_device(globs)
    print(f"==> done: {nshot} screenshot(s), {nrec} recording(s) -> {out}  (iPod cleared)")

    # encode the recordings to video. Default = GIF + H.264 MP4; --prores / --lossless
    # add an Apple ProRes 4444 / a bit-exact qtrle .mov. ffmpeg is fetched on demand.
    recdirs = [d for d in sorted((out / "recordings").glob("rec*"))
               if d.is_dir() and next(d.glob("frame*.png"), None)] if nrec else []
    if recdirs:
        fmts = [f for f in ("gif", "mp4", "prores", "lossless") if getattr(args, f, False)]
        if not fmts:
            fmts = ["gif", "mp4"]
        if _ensure_ffmpeg():
            _encode_recordings(recdirs, out / "videos", fmts,
                               fps=getattr(args, "fps", 30), force=getattr(args, "force", False))
        else:
            print("   (frames kept; re-run with ffmpeg installed to encode video)")

    if platform.system() == "Darwin":
        subprocess.run(["open", str(out)], check=False)


# ----------------------------------------------------------- video encoding ---
def _ensure_ffmpeg():
    """ffmpeg is only needed to encode videos, so check for it lazily (here, the
    first time an encode runs) rather than in the general setup. If it's missing,
    offer to install it; if the user declines (or there's no way to), skip
    encoding and return False."""
    if _have("ffmpeg"):
        return True
    print("\nffmpeg is needed to encode videos, but it isn't installed.")
    if platform.system() == "Darwin":
        cmd, runner = "brew install ffmpeg", lambda: _run(["brew", "install", "ffmpeg"]).returncode == 0
    else:
        cmd = _linux_pkg_cmd("ffmpeg")
        runner = (lambda: _linux_install("ffmpeg")) if cmd else None
    if runner is None:
        print("  no known way to auto-install ffmpeg here — install it manually, then re-run.")
        return False
    if not _confirm(f"  install it now?  ({cmd})"):
        print("  skipping video encoding (ffmpeg not installed).")
        return False
    runner()
    if not _have("ffmpeg"):
        print("  ffmpeg still isn't on PATH — skipping video encoding.")
        return False
    return True


def _frame_key(p):
    """Numeric sort key so frame9999 < frame10000 (the recorder switches from 4- to
    5-digit names past 9999, which would otherwise mis-order a plain glob)."""
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", p.name)]


# codec recipes: ext + ffmpeg output args. 240x432 is even, so yuv420p is fine for H.264.
_VID_FMTS = {
    "gif":      ("gif",
                 ["-filter_complex", "[0:v] split [a][b];[a] palettegen [p];[b][p] paletteuse"]),
    "mp4":      ("mp4",
                 ["-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "18",
                  "-preset", "slow", "-movflags", "+faststart"]),
    "prores":   ("prores.mov",
                 ["-c:v", "prores_ks", "-profile:v", "4444", "-pix_fmt", "yuv444p10le", "-vendor", "apl0"]),
    "lossless": ("lossless.mov",
                 ["-c:v", "qtrle", "-pix_fmt", "rgb24"]),
}


def _encode_recordings(recdirs, outdir, fmts, fps=30, force=False):
    """Encode each recNNNN frame folder in `recdirs` into the requested video
    formats under `outdir`. Caller has already ensured ffmpeg is available."""
    outdir.mkdir(parents=True, exist_ok=True)
    print(f"==> encoding {len(recdirs)} recording(s) -> {', '.join(fmts)} @ {fps}fps")
    made = skipped = 0
    for rd in recdirs:
        frames = sorted(rd.glob("frame*.png"), key=_frame_key)
        if not frames:
            continue
        # name <session>_<recNNNN> when the recordings/ layout is present, else recNNNN
        session = rd.parent.parent.name if rd.parent.name == "recordings" else ""
        stem = f"{session}_{rd.name}" if session else rd.name

        todo = [f for f in fmts
                if force or not (outdir / f"{stem}.{_VID_FMTS[f][0]}").exists()]
        for f in fmts:
            if f not in todo:
                print(f"   skip   {stem}.{_VID_FMTS[f][0]}  (exists)"); skipped += 1
        if not todo:
            continue

        # symlink the frames into a temp dir with uniform sequential numbering, so
        # ffmpeg reads them in true numeric order regardless of 4-/5-digit padding
        tmp = Path(tempfile.mkdtemp(prefix="nanovid_"))
        try:
            for i, fr in enumerate(frames):
                os.symlink(fr.resolve(), tmp / f"{i:06d}.png")
            for f in todo:
                ext, codec = _VID_FMTS[f]
                out = outdir / f"{stem}.{ext}"
                print(f"   encode {out.name}  ({len(frames)} frames)")
                rc = subprocess.run(
                    ["ffmpeg", "-y", "-nostdin", "-loglevel", "error", "-stats",
                     "-framerate", str(fps), "-start_number", "0", "-i", str(tmp / "%06d.png")]
                    + codec + ["-r", str(fps), str(out)]).returncode
                made += 1 if rc == 0 else 0
                if rc != 0:
                    print(f"   ! ffmpeg failed on {out.name}")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    print(f"==> {made} video(s) encoded, {skipped} skipped -> {outdir}")


# ------------------------------------------------------------------ wizard ----
def pick_target(apps=True, harnesses=True):
    """List the requested target kinds and let the user choose by number or name.
    apps/ are surface apps (installed to the home screen via the pack); harnesses/
    are fixed-VA .bin probes that are SCSI-exec'd once."""
    app_list, harn = [], []
    if apps:
        app_list = [d.name for d in sorted((ROOT / "apps").iterdir())
                    if (d / "Makefile").is_file() and d.name not in NONAPPS]
    if harnesses:
        harn = [d.name for d in sorted((ROOT / "harnesses").iterdir())
                if (d / "Makefile").is_file() and not (d / "Info.plist").exists()]
    names = app_list + harn
    if app_list:
        print("\n  apps:")
        for i, a in enumerate(app_list, 1):
            print(f"    {i:>2}. {a}")
    if harn:
        print("\n  harnesses (one-shot exec):" if not app_list else "  harnesses (one-shot exec):")
        for i, h in enumerate(harn, len(app_list) + 1):
            print(f"    {i:>2}. {h}")
    raw = input("\n  number or name: ").strip()
    if raw.isdigit() and 1 <= int(raw) <= len(names):
        return names[int(raw) - 1]
    return raw


def _new_ns():
    """Prompt for the bits `start new` needs (name + surface kind)."""
    name = input("\n  new app name (lowercase): ").strip()
    print("  kind:  1) LVGL widgets   2) OpenGL   3) Paint-like (raw framebuffer)")
    kind = {"1": "lvgl", "2": "gl", "3": "raw"}.get(input("  choose [1/2/3]: ").strip(), "lvgl")
    return argparse.Namespace(name=name, kind=kind, frm=None, title=None)


def wizard(args, tr):
    ensure_build_deps()             # auto-check + install host deps at launch (silent if present)
    def ins(**kw):
        return argparse.Namespace(targets=kw.get("targets", []),
                                  demo_data=kw.get("demo_data", False),
                                  demo_data_force=kw.get("demo_data_force", False),
                                  resident_only=kw.get("resident_only", False),
                                  untethered=kw.get("untethered", True))
    actions = [
        ("Install all apps",         lambda: cmd_install(ins(), tr)),
        ("Install all apps with demo data", lambda: cmd_install(ins(demo_data=True), tr)),
        ("Install all apps + FORCE-recopy demo data (overwrite on-device edits)",
                                     lambda: cmd_install(ins(demo_data=True, demo_data_force=True), tr)),
        ("Install one app",          lambda: cmd_install(ins(targets=[pick_target(harnesses=False)]), tr)),
        ("Update resident only",
                                     lambda: cmd_install(ins(resident_only=True), tr)),
        ("Run a test harness once",  lambda: cmd_run(argparse.Namespace(target=pick_target(apps=False)), tr)),
        ("Pull screenshots and screen recordings", lambda: cmd_pull(argparse.Namespace(what="media", out=None), tr)),
        ("Pull benchmark CSVs",      lambda: cmd_pull(argparse.Namespace(what="bench", out=None), tr)),
        ("Build all (does not install onto device)", lambda: cmd_build(argparse.Namespace(targets=[]))),
        ("Create a new app",         lambda: cmd_new(_new_ns())),
        ("Install dependencies",     lambda: cmd_bootstrap(argparse.Namespace(check=False), tr)),
        ("Change iPod location (setup)", lambda: cmd_setup(argparse.Namespace())),
        ("Repair iPod disk (fsck)",  lambda: cmd_fsck(argparse.Namespace(), tr)),
        ("Peek DRAM",                lambda: cmd_peek(argparse.Namespace(addr=input("  addr (0x..): ").strip(), n="0x100"), tr)),
        ("Dump trace",               lambda: cmd_trace(argparse.Namespace(n=48), tr)),
        ("Eject iPod (return to Home Screen)", lambda: cmd_eject(argparse.Namespace(), tr)),
        ("Remount iPod disk (Connected mode)", lambda: cmd_remount(argparse.Namespace(), tr)),
    ]
    print(f"start — transport: {tr.desc}\n")
    for i, (label, _) in enumerate(actions, 1):
        print(f"  {i}. {label}")
    print("  q. quit")
    choice = input("\nchoose: ").strip().lower()
    if choice == "q" or not choice:
        return
    try:
        actions[int(choice) - 1][1]()
    except (ValueError, IndexError):
        print("invalid choice")


# -------------------------------------------------------------------- main ----
def main():
    p = argparse.ArgumentParser(prog="start", description="iPod build/deploy/probe driver")
    p.add_argument("--remote", "--pi", dest="remote", default=None,
                   help="SSH host (user@host) of the iPod's Linux computer; forces the SSH transport")
    p.add_argument("--local", action="store_true",
                   help="force local transport (the iPod is attached to THIS computer)")
    sub = p.add_subparsers(dest="cmd")

    # install (alias: deploy). --demo-data / --demo-data-force (aliases --data*).
    for name in ("install", "deploy"):
        sp = sub.add_parser(name)
        sp.add_argument("targets", nargs="*")
        sp.add_argument("--demo-data", "--data", dest="demo_data", action="store_true",
                        help="also copy data/<Name>/ -> /Data, skipping folders already on device")
        sp.add_argument("--demo-data-force", "--data-force", dest="demo_data_force", action="store_true",
                        help="copy data/ -> /Data, OVERWRITING folders already on device")
        sp.add_argument("--resident-only", action="store_true",
                        help="update only the inactive resident slot; preserve the app catalog")
        sp.add_argument("--loader-bundle", type=Path, help="matching output from start firmware build")
        sp.add_argument("--untethered", action="store_true", default=True, help=argparse.SUPPRESS)
    for name in ("deps", "bootstrap"):          # bootstrap == alias
        sp = sub.add_parser(name)
        sp.add_argument("--check", action="store_true", help="report missing deps but don't install")
    sub.add_parser("setup")
    sp = sub.add_parser("new")
    sp.add_argument("name", help="new app folder/executable name (lowercase)")
    sp.add_argument("--kind", choices=["lvgl", "gl", "raw"], default="lvgl",
                    help="surface kind: lvgl widgets (default), gl (OpenGL), raw (Paint-like framebuffer)")
    sp.add_argument("--from", dest="frm", metavar="APP",
                    help="clone a specific existing app instead of the kind's default template")
    sp.add_argument("--title", help="home-screen display name (default: from the name)")
    sp = sub.add_parser("run");    sp.add_argument("target")
    sp = sub.add_parser("firmware")
    sp.add_argument("operation", choices=["build"])
    sp.add_argument("--ipsw", type=Path, help="optional cached Apple IPSW (downloads automatically)")
    sp.add_argument("--revision", choices=["2012", "2015"], required=True)
    sp = sub.add_parser("build");  sp.add_argument("targets", nargs="*")
    sp = sub.add_parser("package", help="build a standalone prebuilt app ZIP (no device needed)")
    sp.add_argument("target")
    sp.add_argument("--output", type=Path, help="ZIP destination (default: build/packages/APP.zip)")
    sp = sub.add_parser("peek");   sp.add_argument("addr"); sp.add_argument("n", nargs="?", default="0x200")
    sp = sub.add_parser("trace");  sp.add_argument("n", nargs="?", type=int, default=48)
    sub.add_parser("eject")
    sub.add_parser("reboot")
    sub.add_parser("remount")
    sub.add_parser("fsck")
    sp = sub.add_parser("pull")
    sp.add_argument("what", nargs="?", choices=["media", "bench"], default="media",
                    help="media = screenshots + recordings (converted + encoded, then cleared); bench = benchmark CSVs")
    sp.add_argument("--out", help="output dir (media default: ~/Desktop/ipod_media_<ts>)")
    # recordings are encoded to video as part of a media pull: GIF + H.264 MP4 by
    # default; these add/extend the set.
    sp.add_argument("--prores",   action="store_true", help="also encode an Apple ProRes 4444 .mov")
    sp.add_argument("--lossless", action="store_true",
                    help="also encode a bit-exact QuickTime Animation (qtrle) .mov")
    sp.add_argument("--gif",      action="store_true", help="encode a GIF (default unless other formats are chosen)")
    sp.add_argument("--mp4",      action="store_true", help="encode an H.264 MP4 (default unless other formats are chosen)")
    sp.add_argument("--fps", type=int, default=30, help="recording frame rate (default 30)")
    sp.add_argument("--force", action="store_true", help="re-encode videos even if the output exists")
    sub.add_parser("wizard")

    args = p.parse_args()

    # these don't touch the device, so don't make them prompt for the iPod's location
    if args.cmd == "firmware":
        build_firmware(args.revision, args.ipsw)
        return
    if args.cmd == "build":
        cmd_build(args); return
    if args.cmd == "package":
        ensure_build_deps()
        from build_apps import app_path
        from package_app import package_app
        folder = app_path(args.target)
        subprocess.run(["make", "-s", "-C", str(folder)], check=True)
        package_app(args.target, args.output)
        return
    if args.cmd == "setup":
        cmd_setup(args); return
    if args.cmd == "new":
        cmd_new(args); return

    # deps doesn't strictly need a configured device (host checks always run; the
    # device-tools section uses the transport only if one's already set up).
    tr = detect_transport(args, need_device=args.cmd not in ("deps", "bootstrap"))

    if args.cmd in ("install", "deploy"):
        cmd_install(args, tr)
    elif args.cmd in ("deps", "bootstrap"):
        cmd_bootstrap(args, tr)
    elif args.cmd == "run":
        cmd_run(args, tr)
    elif args.cmd == "peek":
        cmd_peek(args, tr)
    elif args.cmd == "trace":
        cmd_trace(args, tr)
    elif args.cmd == "eject":
        cmd_eject(args, tr)
    elif args.cmd == "reboot":
        ensure_device_deps(tr)
        tr.restart()
    elif args.cmd == "remount":
        cmd_remount(args, tr)
    elif args.cmd == "fsck":
        cmd_fsck(args, tr)
    elif args.cmd == "pull":
        cmd_pull(args, tr)
    else:                                   # no subcommand -> interactive wizard
        wizard(args, tr)


if __name__ == "__main__":
    main()
