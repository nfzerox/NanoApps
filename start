    os.execv(str(VENV / "bin/python"), [str(VENV / "bin/python"), str(ROOT / "start"), *sys.argv[1:]])
for candidate in (Path.home() / ".cargo/bin", Path("/opt/homebrew/opt/rustup/bin")):
    if (candidate / "cargo").exists():
        os.environ["PATH"] = str(candidate) + os.pathsep + os.environ.get("PATH", "")
        break
