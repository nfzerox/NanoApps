def cmd_fsck(args, tr):
    """Repair the iPod's FAT filesystem. A panic or unclean eject can leave the
    FAT marked 'dirty', which makes Linux mount it READ-ONLY (installs then fail
    with 'Read-only file system'). This clears that and verifies a read-write
    mount."""
    if tr.darwin:
        subprocess.run(["diskutil", "repairVolume", tr.part()], check=True)
        return
    dev = tr.dev(); part = tr.part()
    mnt = tr.mnt()
    print(f"==> repairing {part} on the iPod's computer")
    script = f"""sudo sg_start {dev} --loej 2>/dev/null || true
for i in $(seq 1 40); do test -e {part} && break; sleep 1; done
test -e {part} || {{ echo 'device never appeared in Connected mode' >&2; exit 1; }}
udisksctl unmount -b {part} 2>/dev/null || sudo umount {part} 2>/dev/null || true
sudo fsck.vfat -a -w -v {part} 2>&1 | tail -20 || sudo fsck.vfat -a -w {part} || true
echo '--- verifying read-write mount ---'
sudo mkdir -p {mnt}
if sudo mount -o rw,flush,uid=$(id -u),gid=$(id -g) {part} {mnt} 2>/dev/null && sudo touch {mnt}/.hbrw 2>/dev/null; then
  sudo rm -f {mnt}/.hbrw; sudo umount {mnt}; echo 'OK: the iPod filesystem is healthy and writable'
else
  sudo umount {mnt} 2>/dev/null || true
  echo 'STILL not writable — the FAT may need a deeper repair (back up + reformat the data partition from a PC)'; exit 1
fi"""
    rc = tr.sh(script, check=False).returncode
    tr.eject()              # back to the home screen
    if rc != 0:
        sys.exit(1)


